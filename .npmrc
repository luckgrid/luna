# npm security best practices (also read by Bun for registry settings)
# Source: https://github.com/lirantal/npm-security-best-practices

# SECURITY: do not run lifecycle scripts (postinstall, etc.)
ignore-scripts=true

# SECURITY: reject git-source dependencies (git+ssh:// etc.)
allow-git=none

# SECURITY: block packages newer than 14 days
min-release-age=14
