# PORTS (local dev: API 8000 = typical Uvicorn; APP 3000 = typical Vite/SPA; WEB 3001 = Hugo)
API_PORT=8000
APP_PORT=3000
WEB_PORT=3001

# HOSTS
API_HOST=api.example.com # http://localhost:8000 (.env.local)
APP_HOST=app.example.com # http://localhost:3000 (.env.local)
WEB_HOST=www.example.com # http://localhost:3001 (.env.local)

# URLs
API_BASE_URL=https://api.example.com # http://localhost:8000 (.env.local)
APP_BASE_URL=https://app.example.com # http://localhost:3000 (.env.local)
WEB_BASE_URL=https://example.com # http://localhost:3001 (.env.local)

# DEV
API_DEBUG=true  # api app debug: docs, SQL echo, CORS fallbacks

# DB
DATABASE_URL=sqlite+aiosqlite:///./data.db

# AI
AI_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here


# LUNA (optional cli config - set in shell or .env.local; see README)
# LUNA_FIREWALL=1  # wrap uv/cargo with Socket Firewall (sfw)
# LUNA_MIN_RELEASE_AGE=14  # min package age in days for install/update
# LUNA_FULL_GRAPH=1  # go outdated/update uses full module graph
